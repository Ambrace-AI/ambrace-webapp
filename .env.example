# Copy to .env.local and fill in. Never commit .env.local.

# Backend API (dev: https://api-dev.ambrace.in, local backend: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=https://api-dev.ambrace.in

# PostHog. Analytics stay off until a key is set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Shows the voice diagnostics panel outside development when "true".
NEXT_PUBLIC_VOICE_DIAGNOSTICS=false
